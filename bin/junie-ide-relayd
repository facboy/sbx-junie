#!/usr/bin/env python3
"""Host-side half of the Junie IDE relay: publishes the host's IDEs on one port.

Junie inside the sandbox reaches an IDE at `127.0.0.1:<port>`, naming the port
from a per-project instance file. A sandbox cannot dial the IDE's own port: the
kit's egress allowlist must name a port, and the IDE plugin picks an ephemeral
one that changes on every restart. This daemon gives every IDE the same fixed
host port instead. The sandbox-side relay opens a loopback endpoint for the one
project its sandbox holds and sends a one-line preamble naming that project and
the secret it was provisioned with; the daemon resolves the digest to the IDE's
current port from the host's instance files, checks the secret against the
project it authorises, and splices the connection through.

The IDE's built-in MCP server is reached the same way, on a preamble of its own:
the CLI builds that server's URL itself as `http://localhost:<port>/stream`,
from a port the plugin hands back over its RPC. That address is the sandbox's own
loopback, where nothing listens, so `mcp <digest> <secret>` resolves the plugin's
current MCP port and splices to it, and `mcp-port <digest> <secret>` answers with
that port for a sandbox-side endpoint to bind. Both are resolved per connection,
since the port moves when the IDE restarts.

The MCP exchange is parsed rather than spliced byte for byte, so that only the
tools the sandbox needs reach the host: see `splice_mcp`. A tool the allowlist
does not name is removed from `tools/list` and refused on `tools/call`, so a tool
a later IDE build adds arrives unreviewed rather than unrestricted. The RPC
relay above is left a plain splice.

Every preamble but `health` carries the sandbox's secret, which `junie-sbx.sh`
provisions as it starts the sandbox: one record per project under
`${XDG_CONFIG_HOME:-$HOME/.config}/junie-sbx/relay-secrets`, naming the project
and its secret. A connection is spliced only when its secret matches a record
whose project contains the IDE's, so a sandbox reaches its own project's IDE and
no other, and a local process without the secret reaches nothing at all. A digest
that resolves to no IDE is answered as before -- `gone` says there is nothing to
reach -- so the check does not depend on an IDE being up. A host with no records
relays nothing.

A secret is only a credential while it is the operator's alone, so the daemon
refuses to start when the records, or the directory holding them, are reachable
beyond their owner: the fix it names is `chmod 700` and `chmod 600`, which is
what `junie-sbx.sh` writes. Refusing rather than skipping, since a daemon that
started anyway would keep a reach its operator believes it denied.

The tool allowlist comes from `DEFAULT_ALLOW_TOOLS` unless a TOML config file or
the flags below name another:

    allow_tools = ["apply_patch", "get_*"]

It is read from `${XDG_CONFIG_HOME:-$HOME/.config}/junie-sbx/relayd.toml`, or
`$JUNIE_IDE_RELAYD_CONFIG`, or `--config PATH`, each overriding the one before.
`SIGHUP` re-reads it, so a change needs no restart.

    bin/junie-ide-relayd [--port PORT] [--instances DIR] [--secrets DIR]
                          [--config PATH] [--allow-tool NAME]...
                          [--no-tool-filter]

`mcp-port` answers `none` when the plugin reports no built-in server, and `gone`
when the IDE behind the digest is no longer running. The sandbox closes a mirror
for either, so a port the IDE gave up is not held open, but keeps one for
`unknown` -- the plugin answered nothing, which a momentary failure looks like
too. The health reply names the protocol version, so a sandbox can tell this
daemon from one started before it learned these preambles and ask for a restart
rather than read the silence as a dead IDE.

Binds `127.0.0.1` only -- the sandbox reaches it through the runtime's
host-loopback forwarding, which the kit allowlists as `localhost:<PORT>`.
Loopback is shared with every other local process, so the port is no boundary by
itself; the secret is what keeps one sandbox out of another project's IDE. Both
the instance files and the secret records are re-read on every connection, so an
IDE that restarts on a new port, or a project provisioned after this daemon
started, needs no restart.
"""
import argparse
import hashlib
import hmac
import http.client
import json
import os
import select
import signal
import socket
import sys
import threading
import tomllib

DEFAULT_PORT = 27183
CONFIG_BASENAME = "relayd.toml"
SECRETS_DIRNAME = "relay-secrets"
# Records hold the hex `secrets.token_hex(32)` that `junie-sbx.sh` wrote.
SECRET_HEX_LEN = 64
PREAMBLE_PREFIX = b"JUNIE-RELAY 1 "
# Bumped when a preamble the sandbox side depends on is added, so that a daemon
# started before it is recognisable rather than silently rejecting the preamble.
# A daemon too old to name a version answers the bare `ok` a 1 daemon also does.
# 3 is the secret on every preamble but `health`: the sandbox publishes nothing
# against a 2 daemon, which splices whatever project a caller names.
PROTOCOL_VERSION = 3
HEALTH_PAYLOAD = b"health"
HEALTH_REPLY = ("JUNIE-RELAY 1 ok %d\n" % PROTOCOL_VERSION).encode()
MCP_CREDENTIALS_METHOD = "JunieMcpService.getBuiltInMcpServerCredentials"
MCP_PORT_PREFIX = b"mcp-port "
MCP_PREFIX = b"mcp "
MCP_PORT_REPLY = b"JUNIE-RELAY 1 mcp-port %d\n"
MCP_PORT_NONE = b"JUNIE-RELAY 1 mcp-port none\n"
# The IDE behind the digest is gone, distinct from `none`: the plugin was asked
# and answered, and there is no IDE to hold a port for. The sandbox drops the
# mirror on it.
MCP_PORT_GONE = b"JUNIE-RELAY 1 mcp-port gone\n"
# The plugin did not answer, so the port is not known to have moved. The sandbox
# keeps its mirror on this, since a momentary failure answers the same way.
MCP_PORT_UNKNOWN = b"JUNIE-RELAY 1 mcp-port unknown\n"

# What the sandbox may reach through the IDE's built-in MCP server, as patterns:
# an exact tool name, or a name ending in `*`. Anything matching nothing is
# removed from `tools/list` and refused on `tools/call`, so a tool a later IDE
# build adds cannot arrive unreviewed.
#
# The project is writable from the sandbox, so it is the payload: a build, lint,
# reformat, run configuration, `execute_sql_query` or terminal command runs
# project-controlled code on the host, and a kernel does the same through an
# interpreter path the sandbox can write. The notebook *file* tools stay, since
# `.ipynb` writes reach no further than `apply_patch`; `execute_tool` names its
# target in its own argument, so a call through it is checked against these same
# patterns. See "MCP tools" in ../README.md.
DEFAULT_ALLOW_TOOLS = (
    "analyze_calls",
    "apply_patch",
    "cancel_sql_query",
    "create_*",
    "edit_*",
    "execute_tool",
    "fetch_query_result",
    "get_*",
    "git_status",
    "introspect_schema",
    "list_*",
    "open_file_in_editor",
    "preview_table_data",
    "read_*",
    "rename_refactoring",
    "search_*",
    "test_database_connection",
)
DISPATCHER_TOOL = "execute_tool"
TOOL_LIST_MARKER = "Available tools: "
REFUSED_REPLY = ('{"jsonrpc":"2.0","id":%s,"error":{"code":-32601,'
                 '"message":"Tool \'%s\' is not available"}}')
MAX_PREAMBLE = 256
IDLE_TIMEOUT = 600


def resolve_instances(explicit):
    if explicit:
        return explicit
    junie_home = os.environ.get("JUNIE_HOME") or os.path.join(os.path.expanduser("~"), ".junie")
    return os.path.join(junie_home, "instances")


def default_config_root():
    """The config root the rest of this repo uses, so one root holds all of it.

    `junie-sbx.sh` puts its read-only view, its state and the relay secrets
    there. `HOME` and the environment are the fallbacks, so a path that is set
    but empty still resolves somewhere real.
    """
    config_home = os.environ.get("XDG_CONFIG_HOME") or os.path.join(
        os.environ.get("HOME") or os.path.expanduser("~"), ".config")
    return os.path.join(config_home, "junie-sbx")


def default_config_path():
    """The config file read when no flag or environment variable names one."""
    return os.environ.get("JUNIE_IDE_RELAYD_CONFIG") or os.path.join(
        default_config_root(), CONFIG_BASENAME)


def default_secrets_dir():
    """Where the per-project secret records are read from."""
    return os.path.join(default_config_root(), SECRETS_DIRNAME)


def read_allow_config(path):
    """The `allow_tools` list a TOML file names, or None when it names none.

    A file that does not exist names none, since it is only one step in a
    search. Anything else wrong with it raises: an unreadable file would
    otherwise leave the built-in list in force while looking like a narrowing
    that had loaded.
    """
    try:
        with open(path, "rb") as handle:
            document = tomllib.load(handle)
    except FileNotFoundError:
        return None
    patterns = document.get("allow_tools")
    if patterns is None:
        return None
    if not isinstance(patterns, list) or not all(isinstance(p, str) for p in patterns):
        raise ValueError("allow_tools must be a list of tool-name strings")
    return tuple(patterns)


def resolve_allow(config_path, allow_tool, no_tool_filter):
    """The (patterns, source) in force: the flags first, then the file, then the
    built-in list. `patterns` is None when the filter is off.
    """
    if no_tool_filter:
        return None, "--no-tool-filter"
    if allow_tool is not None:
        return tuple(allow_tool), "--allow-tool"
    patterns = read_allow_config(config_path)
    if patterns is not None:
        return patterns, config_path
    return DEFAULT_ALLOW_TOOLS, "built-in defaults"


def report_allow(patterns, source):
    if patterns is None:
        sys.stderr.write("junie-ide-relayd: MCP tools are unfiltered (%s)\n" % source)
        return
    named = ", ".join(patterns) if patterns else "none -- every call is refused"
    sys.stderr.write("junie-ide-relayd: allowing MCP tools (%s): %s\n" % (source, named))


class AllowState:
    """The allowlist in force, re-resolved on `SIGHUP`.

    Read once per MCP exchange rather than once per process, so a reload reaches
    the exchanges that start afterwards and leaves the ones already open alone.
    The flags are kept because a reload applies the same precedence: a daemon
    started with `--allow-tool` or `--no-tool-filter` is not reconfigured by a
    file, whichever way it was started.
    """

    def __init__(self, config_path, allow_tool, no_tool_filter):
        self.config_path = config_path
        self.allow_tool = allow_tool
        self.no_tool_filter = no_tool_filter
        self.patterns, self.source = resolve_allow(config_path, allow_tool, no_tool_filter)

    def reload(self):
        """Re-read the config, or keep the current list when that fails.

        A failed reload leaves the daemon as it was: a half-written file is easy
        to `SIGHUP` into, and refusing every tool or exiting would both be worse
        than the list already in force.
        """
        try:
            patterns, source = resolve_allow(self.config_path, self.allow_tool,
                                             self.no_tool_filter)
        except (OSError, ValueError) as err:
            sys.stderr.write("junie-ide-relayd: keeping the current allowlist: %s: %s\n"
                             % (self.config_path, err))
            return
        self.patterns, self.source = patterns, source
        report_allow(self.patterns, self.source)


def install_reload_handler(state):
    """Reload the allowlist on `SIGHUP`, where the platform has that signal."""
    if not hasattr(signal, "SIGHUP"):
        return
    signal.signal(signal.SIGHUP, lambda _signum, _frame: state.reload())


def read_preamble(conn):
    """Return the payload named by the connection's preamble, or None.

    Read a byte at a time: the preamble ends at a newline but the bytes after it
    are protocol payload, so a buffered reader would swallow the client's first
    request.
    """
    line = b""
    while len(line) < MAX_PREAMBLE:
        try:
            chunk = conn.recv(1)
        except OSError:
            return None
        if not chunk:
            return None
        if chunk == b"\n":
            break
        line += chunk
    else:
        return None
    if not line.startswith(PREAMBLE_PREFIX):
        return None
    return line[len(PREAMBLE_PREFIX):]


def is_digest(payload):
    text = payload.decode("ascii", "replace")
    return len(text) == 32 and all(c in "0123456789abcdef" for c in text)


def instance_for_digest(instances_dir, digest):
    """The newest instance file naming `digest`, as (rpc port, its contents).

    The digest is `md5(project_path)`, which is also how the plugin names its
    own instance files. Resolved per connection rather than cached so that an
    IDE restarted on a new port needs no action inside the sandbox. When more
    than one file names the project -- an IDE that crashed can leave its old one
    behind -- the newest wins, since that is the one a running IDE wrote last.
    """
    try:
        names = sorted(os.listdir(instances_dir))
    except OSError:
        return None
    found = []
    for name in names:
        if not name.endswith(".json"):
            continue
        path = os.path.join(instances_dir, name)
        try:
            with open(path) as handle:
                info = json.load(handle)
            if hashlib.md5(info["project_path"].encode()).hexdigest() != digest:
                continue
            port = int(info["port"])
            if not 1 <= port <= 65535:
                continue
            found.append((os.stat(path).st_mtime, port, info))
        except Exception:
            continue
    if not found:
        return None
    _, port, info = max(found, key=lambda entry: (entry[0], entry[1]))
    return port, info


def port_for_digest(instances_dir, digest):
    """The RPC port the instance file naming `digest` currently advertises."""
    resolved = instance_for_digest(instances_dir, digest)
    return None if resolved is None else resolved[0]


def project_for_digest(instances_dir, digest):
    """The project path the instance file naming `digest` holds, or None."""
    resolved = instance_for_digest(instances_dir, digest)
    if resolved is None:
        return None
    project = resolved[1].get("project_path")
    return project if isinstance(project, str) else None


# What a secret, or the directory holding one, may grant beyond its owner: none.
# `junie-sbx.sh` writes records 0600 inside a 0700 directory, and anything wider
# hands the credential to another local user, who can then reach the project's
# IDE -- the reach the secret exists to deny.
GROUP_OTHER_BITS = 0o077
# Exposed paths already reported, so the per-connection re-read does not repeat
# itself for every relay a running sandbox opens.
REPORTED = set()
REPORTED_LOCK = threading.Lock()


def exposed(path):
    """The group and other access bits `path` carries, or None if unreadable."""
    try:
        return os.stat(path).st_mode & GROUP_OTHER_BITS
    except OSError:
        return None


def exposed_fix(path):
    """The `chmod` that closes `path`, as the daemon names it."""
    return "chmod 700 it" if os.path.isdir(path) else "chmod 600 it"


def exposed_secret_paths(secrets_dir):
    """`secrets_dir` and the records under it that reach beyond their owner.

    Both levels count. A record inside a directory others can read is exposed
    with it, and a directory others can write is one they can add a record of
    their own to. An absent directory is not a problem: it holds no secret, and
    `junie-sbx.sh` creates it 0700.
    """
    if exposed(secrets_dir) is None:
        return []
    problems = [secrets_dir] if exposed(secrets_dir) else []
    try:
        names = sorted(os.listdir(secrets_dir))
    except OSError:
        return problems
    for name in names:
        if name.endswith(".json") and exposed(os.path.join(secrets_dir, name)):
            problems.append(os.path.join(secrets_dir, name))
    return problems


def report_exposed_once(path, fix):
    """Name an exposed path once, rather than once per connection."""
    with REPORTED_LOCK:
        if path in REPORTED:
            return
        REPORTED.add(path)
    sys.stderr.write("junie-ide-relayd: ignoring %s: reachable beyond its owner, so its "
                     "secret is not trusted; %s\n" % (path, fix))


def read_secrets(secrets_dir):
    """The provisioned records, as a list of (project path, secret).

    One record per project, written by `junie-sbx.sh`: a JSON object naming the
    project and the secret its sandbox carries. A record that does not read is
    skipped rather than fatal -- one unreadable file must not take down a daemon
    that serves every sandbox -- and a missing directory is no records at all,
    which relays nothing.

    A secret another local user can read is not a credential, so a record that
    is exposed is skipped however well it parses: it would authorise the reader
    to reach the project it names.
    """
    if exposed(secrets_dir):
        report_exposed_once(secrets_dir, exposed_fix(secrets_dir))
        return []
    records = []
    try:
        names = sorted(os.listdir(secrets_dir))
    except OSError:
        return records
    for name in names:
        if not name.endswith(".json"):
            continue
        path = os.path.join(secrets_dir, name)
        if exposed(path):
            report_exposed_once(path, exposed_fix(path))
            continue
        try:
            with open(path) as handle:
                info = json.load(handle)
            project, secret = info["project_path"], info["secret"]
        except Exception:
            continue
        if isinstance(project, str) and isinstance(secret, str) and secret:
            records.append((project, secret))
    return records


def authorized(secrets_dir, instances_dir, digest, secret):
    """Whether `secret` may reach the IDE `digest` names.

    A secret authorises one project and everything below it, which is the
    containment the sandbox relay publishes under -- so an IDE opened on the
    host later needs no new secret. A digest that resolves to no IDE authorises
    on the secret alone: the caller answers `gone` either way, so nothing is
    reachable and there is nothing to withhold.

    Compared with `hmac.compare_digest`, so that a wrong secret cannot be
    recovered from how long this takes.
    """
    presented = secret.decode("ascii", "replace")
    roots = [project for project, known in read_secrets(secrets_dir)
             if hmac.compare_digest(known, presented)]
    if not roots:
        return False
    project = project_for_digest(instances_dir, digest)
    if project is None:
        return True
    resolved = os.path.realpath(project)
    for root in roots:
        root = os.path.realpath(root)
        if resolved == root or resolved.startswith(root + os.sep):
            return True
    return False


def is_secret(payload):
    text = payload.decode("ascii", "replace")
    return len(text) == SECRET_HEX_LEN and all(c in "0123456789abcdef" for c in text)


def split_digest_secret(payload):
    """The (digest, secret) a preamble names, or (None, None).

    The digest is returned decoded, since that is the form the instance files
    are matched on; the secret stays bytes for `hmac.compare_digest`.
    """
    digest, sep, secret = payload.partition(b" ")
    if not sep or not is_digest(digest) or not is_secret(secret):
        return None, None
    return digest.decode("ascii"), secret


def mcp_port_for_digest(instances_dir, digest):
    """Resolve the loopback port the IDE named by `digest` serves its MCP on.

    Returns (outcome, port), where the outcome is one of:

    - `port`: the plugin named a port, returned alongside it.
    - `none`: the plugin answered and named no built-in server, so there is
      nothing to mirror.
    - `gone`: the IDE behind the digest is not running -- no instance file names
      it, or its RPC port refuses, which is what a file a killed IDE left behind
      looks like. Any mirror of it holds a port nothing will use again.
    - `unknown`: the plugin did not answer, or answered something unusable. This
      is what a momentary failure -- and a plugin too old to serve the call --
      looks like too, so a caller keeps the mirror it has rather than dropping a
      working one.

    The plugin reports the port over its own RPC, so this dials that port with
    the instance file's token and asks -- the same call the CLI makes when it
    registers the server as `ijembedded`. The IDE picks the port, and picks a
    new one when it restarts, so it is resolved per request rather than cached.
    """
    resolved = instance_for_digest(instances_dir, digest)
    if resolved is None:
        return "gone", None
    rpc_port, info = resolved
    token = info.get("rpc_token")
    if not isinstance(token, str):
        return "unknown", None
    body = json.dumps({
        "jsonrpc": "2.0",
        "method": MCP_CREDENTIALS_METHOD,
        "params": {},
        "id": 1,
    })
    try:
        conn = http.client.HTTPConnection("127.0.0.1", rpc_port, timeout=5)
        try:
            conn.request("POST", "/rpc", body=body, headers={
                "Authorization": token,
                "Content-Type": "application/json",
            })
            payload = json.loads(conn.getresponse().read().decode())
        finally:
            conn.close()
        result = payload.get("result")
        if not isinstance(result, dict) or result.get("error") is not None:
            return "unknown", None
        port = result.get("port")
    except ConnectionRefusedError:
        # Nothing listens on the port the instance file names, so the IDE that
        # wrote it is not running. A refused port is the only failure read as
        # `gone`: a server that accepts and then closes without answering is
        # `unknown` below, since a plugin that cannot serve this call is
        # indistinguishable from a momentary one.
        return "gone", None
    except Exception:
        return "unknown", None
    if port is None:
        return "none", None
    try:
        port = int(port)
    except (TypeError, ValueError):
        return "unknown", None
    if not 1 <= port <= 65535:
        return "unknown", None
    return "port", port


class HttpConnection:
    """A socket and the bytes already read past the last message boundary.

    The message boundary matters because the payload either side of it is
    opaque: a buffered reader that ran past it would hand the next message's
    first line to the caller as if it were body.
    """

    def __init__(self, sock):
        self.sock = sock
        self.buffer = b""

    def fill(self):
        try:
            data = self.sock.recv(65536)
        except OSError:
            return False
        if not data:
            return False
        self.buffer += data
        return True

    def read_head(self):
        """The next head, its closing CRLFCRLF included, or None at EOF."""
        while b"\r\n\r\n" not in self.buffer:
            if not self.fill():
                return None
        head, _, rest = self.buffer.partition(b"\r\n\r\n")
        self.buffer = rest
        return head + b"\r\n\r\n"

    def read_line(self):
        while b"\r\n" not in self.buffer:
            if not self.fill():
                return None
        line, _, rest = self.buffer.partition(b"\r\n")
        self.buffer = rest
        return line

    def read_exact(self, count):
        while len(self.buffer) < count and self.fill():
            pass
        data, self.buffer = self.buffer[:count], self.buffer[count:]
        return data

    def read_chunked(self):
        """A chunked body as the raw bytes that frame it, or None if malformed."""
        raw = []
        while True:
            line = self.read_line()
            if line is None:
                return None
            raw.append(line + b"\r\n")
            try:
                size = int(line.split(b";", 1)[0].strip() or b"0", 16)
            except ValueError:
                return None
            if size == 0:
                while True:
                    trailer = self.read_line()
                    if trailer in (None, b""):
                        break
                    raw.append(trailer + b"\r\n")
                raw.append(b"\r\n")
                return b"".join(raw)
            raw.append(self.read_exact(size))
            raw.append(self.read_exact(2))


def parse_head(head):
    """The start line of a message head, and its lower-cased headers."""
    lines = head.split(b"\r\n")
    headers = {}
    for line in lines[1:]:
        name, sep, value = line.partition(b":")
        if sep:
            headers[name.strip().lower()] = value.strip()
    return lines[0], headers


def read_body(conn, headers):
    """The next body as raw bytes, or None when its framing is unusable.

    Returns empty when the message declares no body, which is the ordinary
    shape of a request that carries none.
    """
    if b"chunked" in headers.get(b"transfer-encoding", b"").lower():
        return conn.read_chunked()
    length = headers.get(b"content-length")
    if length is None:
        return b""
    try:
        return conn.read_exact(int(length))
    except ValueError:
        return None


def is_bounded(head, headers):
    """Whether a response ends by itself, rather than streaming until close.

    A declared length, or a terminating chunk, ends the body. `GET /stream` is
    the session's server-to-client channel: it is chunked for the life of the
    session and ends only when the session does, so a chunked body is not
    bounded on its own and the stream has to be passed through as it arrives.
    """
    if is_event_stream(headers):
        return False
    if b"chunked" in headers.get(b"transfer-encoding", b"").lower():
        return True
    return b"content-length" in headers or header_status(head) in (204, 304)


def is_event_stream(headers):
    """Whether a response is an SSE stream, which ends when it closes."""
    media_type = headers.get(b"content-type", b"").split(b";", 1)[0]
    return media_type.strip().lower() == b"text/event-stream"


def header_status(head):
    parts = head.split(b" ", 2)
    try:
        return int(parts[1])
    except (IndexError, ValueError):
        return 0


def allowed_tool(name, allow):
    """Whether `name` matches a pattern in `allow`.

    A pattern is an exact tool name, or a name ending in `*` that matches every
    tool whose name begins with it.
    """
    if not isinstance(name, str):
        return False
    for pattern in allow:
        if pattern.endswith("*"):
            if name.startswith(pattern[:-1]):
                return True
        elif name == pattern:
            return True
    return False


def refused_tool(params, allow):
    """The tool a `tools/call` reaches that `allow` does not cover, or None.

    A name the allowlist does not cover is refused, which is what stops a tool a
    later IDE build adds from arriving unreviewed. A call through `execute_tool`
    names its target inside its own argument, so that argument is checked as
    well: the tool name has to appear there literally for the dispatcher to
    resolve it, which is what makes its first word enough. A dispatcher call
    whose command cannot be read names nothing to check, and is refused.
    """
    name = params.get("name")
    if not isinstance(name, str):
        return DISPATCHER_TOOL
    if not allowed_tool(name, allow):
        return name
    if name != DISPATCHER_TOOL:
        return None
    command = (params.get("arguments") or {}).get("command")
    if not isinstance(command, str):
        return DISPATCHER_TOOL
    words = command.strip().split()
    if words and allowed_tool(words[0], allow):
        return None
    return words[0] if words else DISPATCHER_TOOL


def scrub_tool_list(text, allow):
    """The dispatch error's own tool listing, with unlisted names removed."""
    index = text.find(TOOL_LIST_MARKER)
    if index < 0:
        return text
    head = text[:index + len(TOOL_LIST_MARKER)]
    names = [name.strip() for name in text[len(head):].split(",")]
    return head + ", ".join(name for name in names if allowed_tool(name, allow))


def scrub_payload(payload, allow):
    """Remove unlisted tools from a `tools/list` result and a dispatch listing.

    Returns True when the payload changed and so has to be re-framed.
    """
    if not isinstance(payload, dict) or not isinstance(payload.get("result"), dict):
        return False
    result = payload["result"]
    changed = False
    tools = result.get("tools")
    if isinstance(tools, list):
        kept = [tool for tool in tools
                if isinstance(tool, dict) and allowed_tool(tool.get("name"), allow)]
        if len(kept) != len(tools):
            result["tools"] = kept
            changed = True
    for item in result.get("content") or []:
        if isinstance(item, dict) and isinstance(item.get("text"), str):
            text = scrub_tool_list(item["text"], allow)
            if text != item["text"]:
                item["text"] = text
                changed = True
    return changed


def rebuild_head(head, length):
    """A message head declaring `length` bytes, its framing replaced."""
    lines = head.split(b"\r\n")
    kept = [lines[0]]
    for line in lines[1:]:
        if not line:
            continue
        name = line.partition(b":")[0].strip().lower()
        if name in (b"content-length", b"transfer-encoding"):
            continue
        kept.append(line)
    kept.append(b"Content-Length: %d" % length)
    return b"\r\n".join(kept) + b"\r\n\r\n"


def decode_chunked(raw):
    """The payload a chunked body frames, or None when it is malformed."""
    payload = bytearray()
    rest = raw
    while True:
        line, _, rest = rest.partition(b"\r\n")
        try:
            size = int(line.split(b";", 1)[0].strip() or b"0", 16)
        except ValueError:
            return None
        if size == 0:
            return bytes(payload)
        if len(rest) < size + 2:
            return None
        payload += rest[:size]
        rest = rest[size + 2:]


def filtered_response(head, body, allow):
    """A response with the tools outside `allow` removed, or None to pass it.

    Only a JSON body is rewritten. An event-stream body carries its payload on
    `data:` lines, and a listing on one is left alone: the IDE answers a
    `tools/list` on JSON -- it refuses a request that accepts events alone -- and
    a client that did ask for events still has its calls refused.
    """
    _, headers = parse_head(head)
    if b"json" not in headers.get(b"content-type", b"").lower():
        return None
    content = body
    if b"chunked" in headers.get(b"transfer-encoding", b"").lower():
        content = decode_chunked(body)
        if content is None:
            return None
    try:
        payload = json.loads(content)
    except ValueError:
        return None
    if not scrub_payload(payload, allow):
        return None
    encoded = json.dumps(payload).encode()
    return rebuild_head(head, len(encoded)), encoded


def splice(client, upstream):
    """Relay both directions until each has seen EOF from the other.

    An EOF is propagated as a half-close rather than a teardown: a client that
    sends a request and then shuts down its write side would otherwise have the
    reply it is still waiting for discarded, because the read loop returned
    before the IDE answered.
    """
    peers = {client: upstream, upstream: client}
    open_directions = {client, upstream}
    try:
        while open_directions:
            readable, _, _ = select.select(list(open_directions), [], [], IDLE_TIMEOUT)
            if not readable:
                return
            for source in readable:
                try:
                    data = source.recv(65536)
                except OSError:
                    open_directions.discard(source)
                    continue
                if not data:
                    open_directions.discard(source)
                    try:
                        peers[source].shutdown(socket.SHUT_WR)
                    except OSError:
                        pass
                    continue
                peers[source].sendall(data)
    finally:
        for sock in peers:
            sock.close()


def splice_to(conn, port, digest):
    try:
        upstream = socket.create_connection(("127.0.0.1", port), timeout=5)
    except OSError as err:
        conn.close()
        sys.stderr.write("junie-ide-relayd: %s: %s\n" % (digest, err))
        return
    upstream.settimeout(None)
    conn.settimeout(None)
    splice(conn, upstream)


def reply_mcp_port(conn, instances_dir, digest):
    """Answer with the IDE's built-in MCP port, for a caller to bind.

    One line, like the health reply, so the sandbox side can tell a resolved
    port from a daemon that cannot reach the IDE. `none` and `gone` are told
    apart from `unknown` because the caller drops a mirror on the first two and
    keeps it on the last -- see `mcp_port_for_digest`.
    """
    outcome, port = mcp_port_for_digest(instances_dir, digest)
    if outcome == "port":
        reply = MCP_PORT_REPLY % port
    elif outcome == "none":
        reply = MCP_PORT_NONE
    elif outcome == "gone":
        reply = MCP_PORT_GONE
    else:
        reply = MCP_PORT_UNKNOWN
    try:
        conn.sendall(reply)
    except OSError:
        pass
    conn.close()


def splice_mcp(client, upstream, allow):
    """Splice the MCP exchange with everything outside `allow` removed.

    A byte splice cannot do this: the tool to remove is named inside a JSON
    body, in the `tools/list` reply and in the `tools/call` request. So both
    directions are framed as HTTP here, and a request naming a tool the
    allowlist does not cover is answered by the daemon instead of being
    forwarded -- the IDE is never asked to run it.

    One thread per direction, because the response side is not driven by the
    request side's read loop: the session's `GET /stream` response stays open
    while the client sends nothing on it.

    `allow` is None when the filter is off, which is not the same as an empty
    list: an empty list names no tool, so every call is refused. Only None
    passes everything through.
    """
    client_conn, upstream_conn = HttpConnection(client), HttpConnection(upstream)
    write_lock = threading.Lock()
    session = {}

    def refuse(message):
        # Only a tool call is checked: `initialize`, `tools/list` and the
        # notifications name no tool, and the reply to `tools/list` is filtered
        # on the way back instead.
        if message.get("method") != "tools/call":
            return None
        request_id = message.get("id")
        if request_id is None:
            # A notification has no reply, and the IDE will not be sent the
            # call either, so there is nothing to answer.
            return None
        name = refused_tool(message.get("params") or {}, allow)
        if name is None:
            return None
        body = (REFUSED_REPLY % (json.dumps(request_id), name)).encode()
        head = b"HTTP/1.1 200 OK\r\nContent-Type: application/json\r\n"
        if session.get("id"):
            head += b"mcp-session-id: " + session["id"].encode() + b"\r\n"
        return head + b"Content-Length: %d\r\n\r\n" % len(body) + body

    def forward_requests():
        while True:
            head = client_conn.read_head()
            if head is None:
                try:
                    upstream.shutdown(socket.SHUT_WR)
                except OSError:
                    pass
                return
            _, headers = parse_head(head)
            body = read_body(client_conn, headers)
            if body is None:
                return
            if body and allow is not None:
                try:
                    message = json.loads(body)
                except ValueError:
                    message = None
                if isinstance(message, dict) and isinstance(message.get("method"), str):
                    refusal = refuse(message)
                    if refusal is not None:
                        with write_lock:
                            try:
                                client.sendall(refusal)
                            except OSError:
                                pass
                        continue
            try:
                upstream.sendall(head + body)
            except OSError:
                return

    def forward_responses():
        try:
            while True:
                head = upstream_conn.read_head()
                if head is None:
                    break
                _, headers = parse_head(head)
                session_id = headers.get(b"mcp-session-id")
                if session_id:
                    session["id"] = session_id.decode("ascii", "replace")
                if not is_bounded(head, headers):
                    # A stream is passed through as it arrives, and its first
                    # bytes may already sit past the message boundary.
                    with write_lock:
                        client.sendall(head)
                        if upstream_conn.buffer:
                            client.sendall(upstream_conn.buffer)
                            upstream_conn.buffer = b""
                        while True:
                            try:
                                data = upstream.recv(65536)
                            except OSError:
                                break
                            if not data:
                                break
                            try:
                                client.sendall(data)
                            except OSError:
                                break
                    break
                body = read_body(upstream_conn, headers)
                if body is None:
                    break
                replaced = filtered_response(head, body, allow) if allow is not None else None
                with write_lock:
                    client.sendall(head + body if replaced is None else b"".join(replaced))
        except OSError:
            pass
        finally:
            # The IDE has stopped answering, so the client is told the same way
            # a half-close tells it: its own write side stays open, so a request
            # already in flight is not cut off mid-send.
            try:
                client.shutdown(socket.SHUT_WR)
            except OSError:
                pass

    threads = [threading.Thread(target=forward_requests, daemon=True),
               threading.Thread(target=forward_responses, daemon=True)]
    for thread in threads:
        thread.start()
    for thread in threads:
        thread.join()
    client.close()
    upstream.close()


def relay_mcp(conn, instances_dir, digest, allow_state):
    outcome, port = mcp_port_for_digest(instances_dir, digest)
    if outcome != "port":
        conn.close()
        sys.stderr.write("junie-ide-relayd: no built-in MCP server for digest %s (%s)\n"
                         % (digest, outcome))
        return
    try:
        upstream = socket.create_connection(("127.0.0.1", port), timeout=5)
    except OSError as err:
        conn.close()
        sys.stderr.write("junie-ide-relayd: %s: %s\n" % (digest, err))
        return
    upstream.settimeout(IDLE_TIMEOUT)
    conn.settimeout(IDLE_TIMEOUT)
    splice_mcp(conn, upstream, allow_state.patterns)


def relay_rpc(conn, instances_dir, digest):
    port = port_for_digest(instances_dir, digest)
    if port is None:
        conn.close()
        sys.stderr.write("junie-ide-relayd: no running IDE for digest %s\n" % digest)
        return
    splice_to(conn, port, digest)


def authenticate(conn, secrets_dir, instances_dir, payload):
    """The digest an authenticated preamble names, or None after closing it.

    Every preamble but `health` carries the secret `junie-sbx.sh` provisioned
    for the sandbox's project, so a connection naming another project's digest
    is refused here rather than spliced to that project's IDE.
    """
    digest, secret = split_digest_secret(payload)
    if digest is None:
        conn.close()
        sys.stderr.write("junie-ide-relayd: rejected a preamble without a project "
                         "digest and secret\n")
        return None
    if not authorized(secrets_dir, instances_dir, digest, secret):
        conn.close()
        sys.stderr.write("junie-ide-relayd: refused %s: no provisioned secret matches\n"
                         % digest)
        return None
    return digest


def handle(conn, instances_dir, secrets_dir, allow_state):
    payload = read_preamble(conn)
    if payload is None:
        conn.close()
        sys.stderr.write("junie-ide-relayd: rejected a connection with no relay preamble\n")
        return
    if payload == HEALTH_PAYLOAD:
        # Lets the sandbox-side relay tell "daemon absent" from "daemon here"
        # in one round trip, instead of inferring it from a failed relay. The
        # reply names the protocol version, so a daemon started before a
        # preamble was added is told apart from one that has it.
        try:
            conn.sendall(HEALTH_REPLY)
        except OSError:
            pass
        conn.close()
        return
    if payload.startswith(MCP_PORT_PREFIX):
        digest = authenticate(conn, secrets_dir, instances_dir, payload[len(MCP_PORT_PREFIX):])
        if digest is not None:
            reply_mcp_port(conn, instances_dir, digest)
        return
    if payload.startswith(MCP_PREFIX):
        digest = authenticate(conn, secrets_dir, instances_dir, payload[len(MCP_PREFIX):])
        if digest is not None:
            relay_mcp(conn, instances_dir, digest, allow_state)
        return
    digest = authenticate(conn, secrets_dir, instances_dir, payload)
    if digest is not None:
        relay_rpc(conn, instances_dir, digest)


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--port", type=int, default=DEFAULT_PORT,
                        help="host port to listen on (default: %(default)s)")
    parser.add_argument("--instances", default="",
                        help="directory holding the IDE instance files "
                             "(default: $JUNIE_HOME/instances)")
    parser.add_argument("--secrets", default="",
                        help="directory holding one JSON record per project, naming "
                             "its path and the secret its sandbox carries; a preamble "
                             "is refused unless its secret matches the project of the "
                             "IDE it names (default: %s)" % default_secrets_dir())
    parser.add_argument("--config", default="",
                        help="TOML file naming the MCP tools the sandbox may reach, "
                             "under `allow_tools`; SIGHUP re-reads it "
                             "(default: $JUNIE_IDE_RELAYD_CONFIG, else "
                             "$XDG_CONFIG_HOME/junie-sbx/%s)" % CONFIG_BASENAME)
    parser.add_argument("--allow-tool", action="append", default=None, metavar="NAME",
                        help="an MCP tool the sandbox may reach, as an exact name or a "
                             "name ending in '*'; repeatable, overriding the config file "
                             "and replacing the defaults")
    parser.add_argument("--no-tool-filter", action="store_true",
                        help="relay the IDE's built-in MCP server unfiltered")
    args = parser.parse_args(argv)

    config_path = args.config or default_config_path()
    try:
        allow_state = AllowState(config_path, args.allow_tool, args.no_tool_filter)
    except (OSError, ValueError) as err:
        # Refused rather than falling back to the defaults: a config file that
        # does not load would otherwise leave a list the operator thinks they
        # replaced.
        sys.stderr.write("junie-ide-relayd: bad config %s: %s\n" % (config_path, err))
        return 1

    instances_dir = resolve_instances(args.instances)
    if not os.path.isdir(instances_dir):
        sys.stderr.write("junie-ide-relayd: no instance directory at %s\n" % instances_dir)
        return 1

    secrets_dir = args.secrets or default_secrets_dir()
    exposed_paths = exposed_secret_paths(secrets_dir)
    if exposed_paths:
        # Fatal rather than skipped: a secret others can read is one others
        # hold, and a daemon that started anyway would keep a reach its operator
        # believes it denied.
        for path in exposed_paths:
            sys.stderr.write("junie-ide-relayd: %s is reachable beyond its owner: %s\n"
                             % (path, exposed_fix(path)))
        return 1
    if not read_secrets(secrets_dir):
        sys.stderr.write("junie-ide-relayd: no relay secrets in %s: every relay "
                         "connection is refused until junie-sbx.sh provisions one\n"
                         % secrets_dir)

    listener = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    listener.bind(("127.0.0.1", args.port))
    listener.listen(64)
    sys.stderr.write("junie-ide-relayd: listening on 127.0.0.1:%d, instances %s\n"
                     % (args.port, instances_dir))
    report_allow(allow_state.patterns, allow_state.source)
    install_reload_handler(allow_state)

    while True:
        try:
            conn, _ = listener.accept()
        except OSError:
            continue
        threading.Thread(target=handle,
                         args=(conn, instances_dir, secrets_dir, allow_state),
                         daemon=True).start()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
